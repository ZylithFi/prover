# both containers are selected by immutable registry digests.
ZYLITH_PROOF_WORKER_IMAGE=ghcr.io/zylithfi/prover@sha256:
ZYLITH_STWO_IMAGE=ghcr.io/starkware-libs/starknet-privacy/transaction-prover@sha256:

# this one-time credential expires quickly and can register only this pinned worker.
ZYLITH_PROOF_QUEUE_URL=https://control.example.invalid
ZYLITH_PROOF_WORKER_REGISTRATION_TOKEN=
ZYLITH_PROOF_WORKER_ID=spot-instance-id
ZYLITH_PROVER_BUILD_ID=
ZYLITH_PROOF_VERSION=
ZYLITH_VIRTUAL_PROGRAM_HASH=
ZYLITH_STARKNET_OS_CONFIG_HASH=
ZYLITH_PROOF_WORKER_POLL_MS=250
ZYLITH_PROOF_WORKER_REQUEST_TIMEOUT_SECONDS=900

# only these values are passed to the isolated stwo container.
ZYLITH_STWO_RPC_URL=https://starknet-sepolia.example.invalid/rpc/v0_10
ZYLITH_STWO_CHAIN_ID=SN_SEPOLIA
ZYLITH_STWO_MAX_CONCURRENT_REQUESTS=1
ZYLITH_STWO_MAX_QUEUED_REQUESTS=0
ZYLITH_STWO_QUEUE_WAIT_TIMEOUT_MILLIS=1000
ZYLITH_STWO_MAX_CONNECTIONS=2
ZYLITH_STWO_PREFETCH_STATE=true
ZYLITH_STWO_COMPILED_CLASS_CACHE_SIZE=64
ZYLITH_STWO_MAX_REQUEST_BODY_SIZE=67108864
