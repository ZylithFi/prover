# this one-time credential expires quickly and can register only this pinned worker.
ZYLITH_PROOF_QUEUE_URL=https://control.example.invalid
ZYLITH_PROOF_WORKER_REGISTRATION_TOKEN=
ZYLITH_PROOF_WORKER_ID=spot-instance-id
ZYLITH_PROVER_BUILD_ID=stwo-production-v1
ZYLITH_PROOF_VERSION=PROOF1
ZYLITH_VIRTUAL_PROGRAM_HASH=0x0
ZYLITH_STARKNET_OS_CONFIG_HASH=0x0
# the local stwo engine is bound to the same machine or container network.
ZYLITH_STWO_PROVER_URL=http://127.0.0.1:3100
ZYLITH_PROOF_WORKER_POLL_MS=250
ZYLITH_PROOF_WORKER_REQUEST_TIMEOUT_SECONDS=900
